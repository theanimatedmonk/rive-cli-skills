        <Fill name="Haze" id="0:3">
            <SolidColor colorValue="FFF6D6D4" name="Color" id="0:4"/>
        </Fill>
        <!-- Ruins -> (restore) -> Restoring -> Glory -> (ruin) -> Decaying -> Ruins.
             The timelines key `glory`; the script does the rest: fragments fly
             back onto their pillars, the overgrowth recedes, the light warms. -->
        <StateMachine name="Scene" id="0:100">
            <StateMachineLayer name="Glory" id="0:101">
                <AnyState x="200" y="-120" id="0:102"/>
                <ExitState x="400" y="-120" id="0:103"/>
                <EntryState id="0:104">
                    <StateTransition stateToId="0:105" id="0:106"/>
                </EntryState>
                <AnimationState x="200" animationId="0:110" id="0:105">
                    <StateTransition stateToId="0:120" id="0:1210">
                        <TransitionViewModelCondition id="0:1211">
                            <TransitionPropertyViewModelComparator id="0:1212">
                                <BindablePropertyTrigger id="0:1213">
                                    <DataBindContext sourcePathIds="0:500-0:514" propertyKey="686" id="0:1214"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator id="0:1215"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="200" y="140" animationId="0:130" id="0:120">
                    <StateTransition stateToId="0:121" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" id="0:1220"/>
                </AnimationState>
                <AnimationState x="200" y="280" animationId="0:140" id="0:121">
                    <StateTransition stateToId="0:122" id="0:1230">
                        <TransitionViewModelCondition id="0:1231">
                            <TransitionPropertyViewModelComparator id="0:1232">
                                <BindablePropertyTrigger id="0:1233">
                                    <DataBindContext sourcePathIds="0:500-0:515" propertyKey="686" id="0:1234"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator id="0:1235"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" y="140" animationId="0:150" id="0:122">
                    <StateTransition stateToId="0:105" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" id="0:1240"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>
        <!-- Ruins: overgrown, the fragments lying in the grass. -->
        <LinearAnimation duration="60" loopValue="1" name="Ruins" id="0:110">
            <KeyedObject objectId="0:84" id="0:111">
                <KeyedProperty propertyKey="243" id="0:112">
                    <KeyFrameDouble interpolationType="1" id="0:113"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Restoring: the 10 s RuinsToGlory animation from Blender. -->
        <LinearAnimation duration="600" name="Restore" id="0:130">
            <KeyedObject objectId="0:84" id="0:131">
                <KeyedProperty propertyKey="243" id="0:132">
                    <KeyFrameDouble interpolationType="1" id="0:133"/>
                    <KeyFrameDouble value="1" interpolationType="1" frame="600" id="0:134"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Full glory. -->
        <LinearAnimation duration="60" loopValue="1" name="Glory" id="0:140">
            <KeyedObject objectId="0:84" id="0:141">
                <KeyedProperty propertyKey="243" id="0:142">
                    <KeyFrameDouble value="1" interpolationType="1" id="0:143"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Back to ruin, faster. -->
        <LinearAnimation duration="180" name="Decay" id="0:150">
            <KeyedObject objectId="0:84" id="0:151">
                <KeyedProperty propertyKey="243" id="0:152">
                    <KeyFrameDouble value="1" interpolationType="1" id="0:153"/>
                    <KeyFrameDouble interpolationType="1" frame="180" id="0:154"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- The camera and the weather, for a page or later states to drive. -->
