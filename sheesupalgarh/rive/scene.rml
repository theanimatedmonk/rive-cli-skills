            </ScriptInputNumber>
            <ScriptInputNumber name="dragY" id="0:94">
                <DataBindContext sourcePathIds="0:500-0:561" propertyKey="243" id="0:95"/>
            </ScriptInputNumber>
            <ScriptInputNumber propertyValue="0.6" name="gustiness" id="0:17"/>
            <ScriptInputNumber propertyValue="1" name="flutter" id="0:18"/>
            <ScriptInputNumber propertyValue="0.5" name="clouds" id="0:19"/>
            <ScriptInputNumber propertyValue="0.7" name="bloom" id="0:20"/>
            <ScriptInputNumber propertyValue="0.18" name="glow" id="0:21"/>
            <ScriptInputNumber propertyValue="0.5" name="depthOfField" id="0:22"/>
            <ScriptInputNumber propertyValue="0.95" name="exposure" id="0:23"/>
            <ScriptInputNumber propertyValue="0.03" name="pollenSize" id="0:24"/>
            <ScriptInputNumber propertyValue="1" name="pollenSpeed" id="0:25"/>
            <ScriptInputNumber propertyValue="0.12" name="petals" id="0:26"/>
            <!-- Bound to the Scene view model, so a page or a state can move the camera and set the wind. -->
