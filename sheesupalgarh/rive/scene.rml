<Rive version="1" kind="fragment">
    <!-- Shishupalgarh: sunlit ruins in a meadow, wind in the leaves, pink
         pollen drifting in the haze. The Ruins node draws the whole 3D scene
         (see Ruins.luau); it sits at the artboard's centre. -->
    <Artboard defaultStateMachineId="0:100" viewModelId="0:500" viewModelInstanceId="0:520" width="1280" height="720" styleId="0:2" name="Shishupalgarh" id="0:1">
        <LayoutComponentStyle name="Shishupalgarh Style" id="0:2"/>
        <ScriptedDrawable scriptAssetId="0:902" x="640" y="360" name="Ruins" id="0:10">
            <ScriptInputString propertyValue="ruins" name="asset" id="0:11"/>
            <ScriptInputNumber propertyValue="1280" name="width" id="0:12"/>
            <ScriptInputNumber propertyValue="720" name="height" id="0:13"/>
