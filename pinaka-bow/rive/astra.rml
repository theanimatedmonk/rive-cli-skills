                <DataBindContext sourcePathIds="2:500-2:507" propertyKey="243" id="2:1811"/>
            </ScriptInputNumber>
            <ScriptInputNumber propertyValue="5" name="sway" id="2:1812"/>
            <ScriptInputNumber propertyValue="-10" name="rotationX" id="2:1813"/>
            <ScriptInputNumber name="rotationY" id="2:1814"/>
            <ScriptInputNumber name="rotationZ" id="2:1815"/>
            <ScriptInputNumber name="spinX" id="2:1816"/>
