<Rive version="1" kind="fragment">
    <!-- The game: King Vikram walks the night, the player's to steer. The
         World node (World.luau) with `play` on: the arrow keys walk him,
         as the camera sees it, along the path to the peepal (he cannot
         leave it); the keypad (8 4 6 2, the number row's too, or W A S D) turns the camera round
         him and tilts it, as in San Andreas; so does a drag, and a touchpad's
         swipe (through dragX / dragY, from the host). A target circle follows
         the pointer; Space held draws an arrow and aims it there, let go it
         looses; a click is the astra (no arrow, the golden wave). The keys reach the World node
         through the Game view model: the listeners below write it, and a
         host (web/game.js) can too. -->
    <Artboard defaultStateMachineId="5:200" viewModelId="5:500" viewModelInstanceId="5:520" x="0" y="1800" width="1280" height="720" styleId="5:2" name="Game" id="5:1">
        <LayoutComponentStyle name="Game Style" id="5:2"/>
        <ScriptedDrawable scriptAssetId="0:902" x="640" y="360" name="World" id="5:10">
            <ScriptInputString propertyValue="world" name="asset" id="5:100"/>
            <ScriptInputNumber propertyValue="1280" name="width" id="5:101"/>
            <ScriptInputNumber propertyValue="720" name="height" id="5:102"/>
            <ScriptInputNumber propertyValue="1" name="resolution" id="5:103"/>
            <ScriptInputNumber propertyValue="4" name="msaa" id="5:104"/>
            <ScriptInputNumber propertyValue="0" name="drift" id="5:105"/>
            <ScriptInputNumber propertyValue="-40" name="sunAzimuth" id="5:106"/>
            <ScriptInputNumber propertyValue="26" name="sunElevation" id="5:107"/>
            <ScriptInputNumber propertyValue="1" name="sunIntensity" id="5:108"/>
            <ScriptInputNumber propertyValue="0.15" name="lightLeak" id="5:109"/>
            <ScriptInputNumber propertyValue="0.6" name="shafts" id="5:110"/>
            <ScriptInputBoolean propertyValue="false" name="navigation" id="5:111"/>
            <ScriptInputNumber name="navMode" id="5:112"/>
            <ScriptInputNumber propertyValue="1" name="zoom" id="5:113"/>
            <ScriptInputNumber name="resetView" id="5:114"/>
            <ScriptInputNumber name="dragX" id="5:115">
                <DataBindContext sourcePathIds="5:500-5:509" propertyKey="243" id="5:319"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="dragY" id="5:116">
                <DataBindContext sourcePathIds="5:500-5:510" propertyKey="243" id="5:320"/>
            </ScriptInputNumber>
            <ScriptInputNumber propertyValue="0.6" name="gustiness" id="5:117"/>
