            <ScriptInputColor propertyValue="FF222E4C" name="hazeColor" id="5:155"/>
            <ScriptInputNumber propertyValue="0" name="cinematic" id="5:156"/>
            <ScriptInputNumber name="camFollow" id="5:157"/>
