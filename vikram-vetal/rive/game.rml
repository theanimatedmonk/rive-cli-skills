        <!-- The game animates itself; this loop keeps the state machine
             (and the view model binds) running. -->
        <LinearAnimation duration="60" loopValue="1" name="Play" id="5:210"/>
        <!-- Playing: the map shown, no card. -->
        <LinearAnimation duration="1" name="Chapter Playing" id="5:820">
            <KeyedObject objectId="5:900">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="5:950">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="5:600">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="5:700">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Fallen: the map and the health fade, and the fallen card. -->
        <LinearAnimation duration="130" name="Chapter Fallen" id="5:822">
            <KeyedObject objectId="5:900">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0" frame="40" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="130" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="5:700">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="40" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="5:950">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="40" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Done: the map and the health fade, and after a breath the card. -->
        <LinearAnimation duration="150" name="Chapter Done" id="5:821">
            <KeyedObject objectId="5:950">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="40" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="5:600">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0" frame="60" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="150" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="5:700">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="40" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

