            <ScriptInputNumber propertyValue="1.69" name="cameraY" id="5:128"/>
            <ScriptInputNumber propertyValue="8.92" name="cameraZ" id="5:129"/>
            <ScriptInputNumber propertyValue="9.5" name="rotationX" id="5:130"/>
            <ScriptInputNumber propertyValue="-33.5" name="rotationY" id="5:131"/>
            <ScriptInputNumber name="rotationZ" id="5:132"/>
            <ScriptInputNumber propertyValue="56" name="fov" id="5:133"/>
            <ScriptInputNumber propertyValue="1" name="windStrength" id="5:134"/>
            <ScriptInputNumber propertyValue="1" name="windSpeed" id="5:135"/>
            <ScriptInputNumber propertyValue="30" name="windDirection" id="5:136"/>
            <ScriptInputNumber propertyValue="1.6" name="haze" id="5:137"/>
            <ScriptInputNumber propertyValue="1500" name="fireflies" id="5:138"/>
