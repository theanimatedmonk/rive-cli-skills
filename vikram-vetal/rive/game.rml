            <Shape name="Veil" id="5:901">
                <Rectangle width="1280" height="720" name="Path" id="5:902"/>
                <Fill name="Fill" id="5:903">
                    <SolidColor colorValue="C0140408" name="Color" id="5:904"/>
                </Fill>
            </Shape>
        </Node>
