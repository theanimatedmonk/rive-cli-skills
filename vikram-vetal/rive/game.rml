    <!-- The keys held (1) or not (0): the arrows walk him, the keypad looks. -->
    <ViewModel name="Game" id="5:500">
        <ViewModelPropertyNumber name="keyUp" id="5:501"/>
        <ViewModelPropertyNumber name="keyDown" id="5:502"/>
        <ViewModelPropertyNumber name="keyLeft" id="5:503"/>
        <ViewModelPropertyNumber name="keyRight" id="5:504"/>
        <ViewModelPropertyNumber name="lookUp" id="5:505"/>
        <ViewModelPropertyNumber name="lookDown" id="5:506"/>
        <ViewModelPropertyNumber name="lookLeft" id="5:507"/>
        <ViewModelPropertyNumber name="lookRight" id="5:508"/>
        <!-- Look: a running total of pixels a host has moved the view by
             (a touchpad's swipe, mouse-look); each change turns it. -->
        <ViewModelPropertyNumber name="dragX" id="5:509"/>
        <ViewModelPropertyNumber name="dragY" id="5:510"/>
        <!-- Space: held 1 (drawing, aiming), let go 0 (it looses). -->
        <ViewModelPropertyNumber name="fire" id="5:511"/>
