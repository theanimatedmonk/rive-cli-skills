            <ScriptInputNumber propertyValue="4.2" name="camDistance" id="5:162"/>
            <ScriptInputNumber propertyValue="2" name="camHeight" id="5:163"/>
            <ScriptInputNumber propertyValue="2.2" name="clearNear" id="5:164"/>
            <ScriptInputNumber propertyValue="1" name="kingHairWind" id="5:196"/>
            <ScriptInputNumber propertyValue="1" name="kingClothWind" id="5:197"/>
            <ScriptInputNumber propertyValue="-14.71" name="kingX" id="5:165"/>
            <ScriptInputNumber propertyValue="13.35" name="kingZ" id="5:166"/>
            <ScriptInputNumber name="kingTurn" id="5:167"/>
            <ScriptInputNumber name="kingPose" id="5:168"/>
            <ScriptInputNumber name="kingRelease" id="5:169"/>
            <ScriptInputNumber propertyValue="1" name="kingAura" id="5:170"/>
            <ScriptInputNumber name="blast" id="5:171"/>
            <ScriptInputNumber propertyValue="1" name="kingSpeed" id="5:172"/>
            <ScriptInputNumber propertyValue="0.3" name="kingFill" id="5:173"/>
            <ScriptInputNumber name="kingBlink" id="5:174"/>
            <ScriptInputNumber propertyValue="45" name="blastRange" id="5:175"/>
            <ScriptInputNumber propertyValue="1.2" name="blastStrength" id="5:176"/>
            <ScriptInputColor propertyValue="FFFFBE5A" name="kingAuraColor" id="5:177"/>
            <ScriptInputColor propertyValue="FFFFB450" name="blastColor" id="5:178"/>
            <ScriptInputString propertyValue="vikram" name="king" id="5:179"/>
            <ScriptInputString propertyValue="vetal" name="vetal" id="5:199"/>
            <ScriptInputNumber name="ghostsFlee" id="5:198"/>
            <!-- The game: King Vikram is the player's. The keys come in on the
                 Game view model (the listeners below, or a host). -->
            <ScriptInputBoolean propertyValue="true" name="play" id="5:300"/>
            <ScriptInputNumber name="keyUp" id="5:301">
                <DataBindContext sourcePathIds="5:500-5:501" propertyKey="243" id="5:311"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="keyDown" id="5:302">
                <DataBindContext sourcePathIds="5:500-5:502" propertyKey="243" id="5:312"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="keyLeft" id="5:303">
                <DataBindContext sourcePathIds="5:500-5:503" propertyKey="243" id="5:313"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="keyRight" id="5:304">
                <DataBindContext sourcePathIds="5:500-5:504" propertyKey="243" id="5:314"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="lookUp" id="5:305">
                <DataBindContext sourcePathIds="5:500-5:505" propertyKey="243" id="5:315"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="lookDown" id="5:306">
                <DataBindContext sourcePathIds="5:500-5:506" propertyKey="243" id="5:316"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="lookLeft" id="5:307">
                <DataBindContext sourcePathIds="5:500-5:507" propertyKey="243" id="5:317"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="fire" id="5:321">
                <DataBindContext sourcePathIds="5:500-5:511" propertyKey="243" id="5:322"/>
            </ScriptInputNumber>
            <ScriptInputNumber name="lookRight" id="5:308">
                <DataBindContext sourcePathIds="5:500-5:508" propertyKey="243" id="5:318"/>
            </ScriptInputNumber>
        </ScriptedDrawable>
        <!-- The keys' surface: full-bleed behind the world, focused as the
             game starts, so the keys have somewhere to go. -->
        <Shape x="640" y="360" name="Keys" id="5:20">
            <FocusData id="5:21"/>
            <Rectangle width="1280" height="720" name="Path" id="5:22"/>
            <Fill name="Night" id="5:23">
                <SolidColor colorValue="FF060A1E" name="Color" id="5:24"/>
            </Fill>
        </Shape>
        <StateMachine name="Game" id="5:200">
            <StateMachineLayer name="Game" id="5:201">
                <AnyState x="200" y="-120" id="5:202"/>
                <ExitState x="400" y="-120" id="5:203"/>
                <EntryState id="5:204">
                    <StateTransition stateToId="5:205" id="5:206"/>
                </EntryState>
                <AnimationState x="200" animationId="5:210" id="5:205">
                    <FocusActionTarget targetId="5:20"/>
                </AnimationState>
            </StateMachineLayer>
            <!-- Each key: held, its number is 1; let go, 0. -->
            <StateMachineListener targetId="5:20" name="keyUp down">
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard">
                    <KeyboardInput keyType="up" keyPhase="1"/>
                </ListenerInputTypeKeyboard>
                <ListenerViewModelChange>
                    <BindablePropertyNumber propertyValue="1">
                        <DataBindContext sourcePathIds="5:500-5:501" propertyKey="636" direction="true"/>
                    </BindablePropertyNumber>
                </ListenerViewModelChange>
            </StateMachineListener>
            <StateMachineListener targetId="5:20" name="keyUp up">
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard">
