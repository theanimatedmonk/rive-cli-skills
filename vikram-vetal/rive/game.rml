<Rive version="1" kind="fragment">
    <!-- The game, chapter I: King Vikram walks the path to the peepal as the
         ghost lights come at him (a wave of them; more than half reaching
         him, he falls), and shoots them down; a column of light near the
         tree ends it. A Map and a Health component sit in the corners. The player's to steer. The
         World node (World.luau) with `play` on: the arrow keys walk him,
         as the camera sees it, along the path to the peepal (he cannot
         leave it); the keypad (8 4 6 2, the number row's too, or W A S D) turns the camera round
         him and tilts it, as in San Andreas; so does a drag, and a touchpad's
         swipe (through dragX / dragY, from the host). A target circle follows
         the pointer; Space held draws an arrow and aims it there, let go it
         looses; a click is the astra (no arrow, the golden wave). The keys reach the World node
         through the Game view model: the listeners below write it, and a
         host (web/game.js) can too. -->
    <Artboard defaultStateMachineId="5:200" viewModelId="5:500" viewModelInstanceId="5:520" x="0" y="1800" width="1280" height="720" styleId="5:2" name="Game" id="5:1">
        <LayoutComponentStyle name="Game Style" id="5:2"/>
        <!-- The chapter's end: a card over the scene (it fades in once he
             reaches the goal; see the Chapter layer). -->
        <Node x="640" y="360" opacity="0" name="Chapter End" id="5:600">
            <Text x="0" y="-92" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Chapter" id="5:5610">
                <TextStylePaint fontSize="20" fontAssetId="0:925" name="Chapter Style" id="5:5611">
                    <Fill name="Fill" id="5:5612">
                        <SolidColor colorValue="FFD8B070" name="Color" id="5:5613"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="5:5611" text="CHAPTER  I" name="Run" id="5:5614"/>
            </Text>
            <Text x="0" y="-38" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Title" id="5:5620">
                <TextStylePaint fontSize="62" fontAssetId="0:925" name="Title Style" id="5:5621">
                    <Fill name="Fill" id="5:5622">
                        <SolidColor colorValue="FFF6E7C8" name="Color" id="5:5623"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="5:5621" text="The Path to the Peepal" name="Run" id="5:5624"/>
            </Text>
            <Text x="0" y="26" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Felled" id="5:5630">
                <TextStylePaint fontSize="22" fontAssetId="0:925" name="Felled Style" id="5:5631">
                    <Fill name="Fill" id="5:5632">
                        <SolidColor colorValue="FFB9C6E6" name="Color" id="5:5633"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="5:5631" text="Spirits felled  0" name="Run" id="5:5634">
                    <DataBindContext sourcePathIds="5:500-5:516" propertyKey="268" id="5:5635"/>
                </TextValueRun>
            </Text>
            <Text x="0" y="78" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Line" id="5:5640">
                <TextStylePaint fontSize="20" fontAssetId="0:925" name="Line Style" id="5:5641">
                    <Fill name="Fill" id="5:5642">
                        <SolidColor colorValue="FFE8C88A" name="Color" id="5:5643"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="5:5641" text="The ghost lights flee. Beneath the peepal, the Vetal waits." name="Run" id="5:5644"/>
            </Text>
            <Text x="0" y="150" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Again" id="5:5650">
                <TextStylePaint fontSize="16" fontAssetId="0:925" name="Again Style" id="5:5651">
