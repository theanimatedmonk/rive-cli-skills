    <Artboard isComponent="true" x="1500" y="0" defaultStateMachineId="3:100" viewModelId="3:500" viewModelInstanceId="3:520" width="1280" height="720" styleId="3:2" name="King" id="3:1">
        <LayoutComponentStyle name="King Style" id="3:2"/>
        <ScriptedDrawable scriptAssetId="0:915" x="640" y="360" name="King" id="3:10">
            <ScriptInputString propertyValue="vikram" name="asset" id="3:11"/>
