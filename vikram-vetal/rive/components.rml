        <!-- The bow's sounds (from ../pinaka-bow). -->
        <AudioEvent assetId="0:910" name="draw" id="3:800"/>
        <AudioEvent assetId="0:909" name="twang" id="3:801"/>
        <Fill name="Night" id="3:3">
            <SolidColor colorValue="FF060A1E" name="Color" id="3:4"/>
        </Fill>
        <StateMachine name="King" id="3:100">
            <StateMachineLayer name="Night" id="3:101">
                <AnyState x="200" y="-120" id="3:102"/>
                <ExitState x="400" y="-120" id="3:103"/>
                <EntryState id="3:104">
                    <StateTransition stateToId="3:105" id="3:106"/>
                </EntryState>
                <AnimationState x="200" animationId="3:110" id="3:105"/>
            </StateMachineLayer>
            <!-- Blinks, at random: after a short or a long look, a blink, a
                 double blink or a slow one. Retime them in the timelines. -->
            <StateMachineLayer name="Blink" id="3:700">
                <AnyState x="-300" y="80" id="3:701"/>
                <ExitState x="600" y="80" id="3:702"/>
                <EntryState x="-300" y="200" id="3:703">
                    <StateTransition stateToId="3:710" id="3:704"/>
                </EntryState>
                <AnimationState x="0" y="200" random="true" animationId="3:720" id="3:710">
                    <StateTransition stateToId="3:712" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="6" id="3:740"/>
                    <StateTransition stateToId="3:713" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="2" id="3:741"/>
                    <StateTransition stateToId="3:714" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="1" id="3:742"/>
                </AnimationState>
                <AnimationState x="0" y="320" random="true" animationId="3:721" id="3:711">
                    <StateTransition stateToId="3:712" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="6" id="3:743"/>
                    <StateTransition stateToId="3:713" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="2" id="3:744"/>
                    <StateTransition stateToId="3:714" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="1" id="3:745"/>
                </AnimationState>
                <AnimationState x="300" y="140" random="true" animationId="3:722" id="3:712">
                    <StateTransition stateToId="3:710" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="2" id="3:746"/>
                    <StateTransition stateToId="3:711" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="1" id="3:747"/>
                </AnimationState>
                <AnimationState x="300" y="260" random="true" animationId="3:723" id="3:713">
                    <StateTransition stateToId="3:710" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="2" id="3:748"/>
                    <StateTransition stateToId="3:711" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="1" id="3:749"/>
                </AnimationState>
                <AnimationState x="300" y="380" random="true" animationId="3:724" id="3:714">
                    <StateTransition stateToId="3:710" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="2" id="3:750"/>
                    <StateTransition stateToId="3:711" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" randomWeight="1" id="3:751"/>
                </AnimationState>
            </StateMachineLayer>
            <!-- The bow's sounds, following the pose and the release: the string
                 drawn as he draws (1.1 s into the draw), the shoot's pull and
                 twang where its clip pulls and lets go (1.0 s, 2.71 s), and a
                 twang when the drawn string is loosed. -->
            <StateMachineLayer name="Bow sounds" id="3:812">
                <AnyState x="-300" y="-120" id="3:810"/>
                <EntryState x="-300" y="0" id="3:811">
                    <StateTransition stateToId="3:806" id="3:813"/>
                </EntryState>
                <AnimationState x="0" y="0" animationId="3:802" id="3:806">
                    <StateTransition stateToId="3:807" id="3:817">
                        <TransitionViewModelCondition opValue="equal" id="3:814">
                            <TransitionPropertyViewModelComparator id="3:815">
                                <BindablePropertyNumber id="3:190107">
                                    <DataBindContext sourcePathIds="3:500-3:501" propertyKey="636" id="3:190108"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="2" id="3:816"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="3:808" id="3:821">
                        <TransitionViewModelCondition opValue="equal" id="3:818">
