            </ScriptInputNumber>
            <ScriptInputNumber name="dragY" id="3:234">
                <DataBindContext sourcePathIds="3:500-3:518" propertyKey="243" id="3:235"/>
            </ScriptInputNumber>
            <!-- His eyes, brought out of the brow's shadow (0-1), and his
                 earrings' glow. -->
            <ScriptInputNumber propertyValue="1" name="eyes" id="3:300">
                <DataBindContext sourcePathIds="3:500-3:530" propertyKey="243" id="3:301"/>
            </ScriptInputNumber>
            <ScriptInputNumber propertyValue="1" name="earringGlow" id="3:302">
                <DataBindContext sourcePathIds="3:500-3:531" propertyKey="243" id="3:303"/>
            </ScriptInputNumber>
            <ScriptInputColor propertyValue="FFFFB046" name="earringColor" id="3:304"/>
            <!-- His bow's aura as he draws it (0-2), and its colour. -->
            <ScriptInputNumber propertyValue="1" name="aura" id="3:308">
                <DataBindContext sourcePathIds="3:500-3:532" propertyKey="243" id="3:309"/>
            </ScriptInputNumber>
            <ScriptInputColor propertyValue="FFFFBE5A" name="auraColor" id="3:310">
                <DataBindContext sourcePathIds="3:500-3:534" propertyKey="836" id="3:313"/>
            </ScriptInputColor>
            <!-- Loosing the string (0-1 over about 3 s): it snaps home and
