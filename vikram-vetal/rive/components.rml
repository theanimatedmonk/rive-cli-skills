            <ScriptInputNumber name="release" id="3:311">
                <DataBindContext sourcePathIds="3:500-3:533" propertyKey="243" id="3:312"/>
            </ScriptInputNumber>
            <!-- His eyelids (0 open, 1 shut): keyed by the Blink layer. -->
            <ScriptInputNumber name="blink" id="3:306"/>
