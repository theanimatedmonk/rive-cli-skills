                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="3" id="3:820"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="300" y="-120" animationId="3:803" id="3:807">
                    <StateTransition stateToId="3:809" id="3:825">
                        <TransitionViewModelCondition opValue="greaterThan" id="3:822">
                            <TransitionPropertyViewModelComparator id="3:823">
