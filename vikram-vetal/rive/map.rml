<Rive version="1" kind="fragment">
    <!-- The map: a 2D component for the game's corner. It shows the path to
         the peepal (the way the walkable path runs, from the jungle's edge
         to the hero tree), the peepal, pulsing gold (where to go), and King
         Vikram, an arrowhead turned the way he faces; under it, how far the
         peepal is and the spirits he has felled. Its view model takes him in
         world metres (x, z) and his heading (degrees, clockwise from the
         map's up, which is -Z); the converters place him on it (x -21..5,
         z -8..21 m over the map). The Game artboard binds it to its own. -->
    <Artboard isComponent="true" defaultStateMachineId="6:200" viewModelId="6:500" viewModelInstanceId="6:520" x="1500" y="1800" width="214" height="262" styleId="6:2" name="Map" id="6:1">
        <LayoutComponentStyle name="Map Style" id="6:2"/>
        <!-- The lettering: how far, and how many felled. -->
        <Text x="107.0" y="226" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Goal" id="6:10">
            <TextStylePaint fontSize="17" fontAssetId="0:925" name="Goal Style" id="6:11">
                <Fill name="Fill" id="6:12">
                    <SolidColor colorValue="FFF1D9A6" name="Color" id="6:13"/>
                </Fill>
            </TextStylePaint>
            <TextValueRun styleId="6:11" text="The peepal" name="Run" id="6:14">
                <DataBindContext sourcePathIds="6:500-6:504" propertyKey="268" id="6:15"/>
            </TextValueRun>
        </Text>
        <Text x="107.0" y="247" originX="0.5" originY="0.5" sizingValue="autoWidth" name="Status" id="6:16">
            <TextStylePaint fontSize="13" fontAssetId="0:925" name="Status Style" id="6:17">
                <Fill name="Fill" id="6:18">
                    <SolidColor colorValue="FF9FB0D8" name="Color" id="6:19"/>
                </Fill>
            </TextStylePaint>
            <TextValueRun styleId="6:17" text="Spirits felled  0" name="Run" id="6:20">
                <DataBindContext sourcePathIds="6:500-6:505" propertyKey="268" id="6:21"/>
            </TextValueRun>
        </Text>
        <!-- King Vikram: an arrowhead, placed and turned by the view model. -->
        <Node x="60.8" y="163.2" name="Vikram" id="6:30">
            <DataBindContext sourcePathIds="6:500-6:501" propertyKey="13" converterId="6:60" id="6:31"/>
            <DataBindContext sourcePathIds="6:500-6:502" propertyKey="14" converterId="6:61" id="6:32"/>
            <DataBindContext sourcePathIds="6:500-6:503" propertyKey="15" converterId="6:62" id="6:33"/>
            <Shape name="Arrowhead" id="6:34">
                <PointsPath isClosed="true" name="Path" id="6:35">
                    <StraightVertex x="0" y="-9" id="0:491843"/>
                    <StraightVertex x="7" y="7" id="0:491844"/>
                    <StraightVertex x="0" y="3.5" id="0:491845"/>
                    <StraightVertex x="-7" y="7" id="0:491846"/>
                </PointsPath>
                <Fill name="Fill" id="6:36">
                    <SolidColor colorValue="FFFFF4E0" name="Color" id="6:37"/>
                </Fill>
                <Stroke thickness="2" join="round" name="Edge" id="6:38">
                    <SolidColor colorValue="FFB34A2A" name="Color" id="6:39"/>
                </Stroke>
            </Shape>
        </Node>
        <!-- The peepal: a tree mark in a gold ring that pulses outward. -->
        <Node x="174.1" y="38.9" name="Peepal" id="6:40">
            <Shape name="Canopy" id="6:41">
                <Ellipse width="13" height="11" y="-3" name="Path" id="6:42"/>
                <Fill name="Fill" id="6:43">
                    <SolidColor colorValue="FF2E5A34" name="Color" id="6:44"/>
                </Fill>
                <Stroke thickness="1.5" name="Edge" id="6:45">
                    <SolidColor colorValue="FFF0C060" name="Color" id="6:46"/>
                </Stroke>
            </Shape>
            <Shape y="5" name="Trunk" id="6:47">
                <Rectangle width="3" height="7" name="Path" id="6:48"/>
                <Fill name="Fill" id="6:49">
                    <SolidColor colorValue="FFF0C060" name="Color" id="6:50"/>
                </Fill>
            </Shape>
            <Shape name="Ring" id="6:51">
                <Ellipse width="26" height="26" name="Path" id="6:52"/>
                <Stroke thickness="2" name="Ring" id="6:53">
                    <SolidColor colorValue="FFF0C060" name="Color" id="6:54"/>
                </Stroke>
            </Shape>
            <Shape name="Pulse" id="6:55">
                <Ellipse width="26" height="26" name="Path" id="6:56"/>
                <Stroke thickness="2" name="Pulse" id="6:57">
                    <SolidColor colorValue="FFF0C060" name="Color" id="6:58"/>
                </Stroke>
            </Shape>
        </Node>
        <!-- The path, a soft earthen band. -->
        <Shape name="Path" id="6:70">
            <PointsPath isClosed="false" name="Route" id="6:71">
                <StraightVertex x="24.8" y="208.4" radius="12" id="0:491847"/>
                <StraightVertex x="36.9" y="190.2" radius="12" id="0:491848"/>
                <StraightVertex x="46.6" y="177.2" radius="12" id="0:491849"/>
                <StraightVertex x="56.6" y="164.4" radius="12" id="0:491850"/>
                <StraightVertex x="70.0" y="157.5" radius="12" id="0:491851"/>
                <StraightVertex x="84.2" y="152.0" radius="12" id="0:491852"/>
                <StraightVertex x="99.3" y="145.3" radius="12" id="0:491853"/>
                <StraightVertex x="110.8" y="133.6" radius="12" id="0:491854"/>
                <StraightVertex x="120.5" y="121.0" radius="12" id="0:491855"/>
                <StraightVertex x="130.1" y="108.6" radius="12" id="0:491856"/>
                <StraightVertex x="139.1" y="94.5" radius="12" id="0:491857"/>
                <StraightVertex x="148.3" y="80.8" radius="12" id="0:491858"/>
                <StraightVertex x="157.9" y="68.8" radius="12" id="0:491859"/>
                <StraightVertex x="161.3" y="58.0" radius="12" id="0:491860"/>
            </PointsPath>
            <Stroke thickness="11" cap="round" join="round" name="Band" id="6:72">
                <SolidColor colorValue="FF6E6A44" name="Color" id="6:73"/>
            </Stroke>
            <Stroke thickness="15" cap="round" join="round" name="Edge" id="6:74">
                <SolidColor colorValue="66242A1A" name="Color" id="6:75"/>
            </Stroke>
        </Shape>
        <!-- The card behind it all. -->
        <Shape x="107.0" y="131.0" name="Card" id="6:80">
            <Rectangle width="214" height="262" cornerRadiusTL="16" cornerRadiusTR="16" cornerRadiusBL="16" cornerRadiusBR="16" name="Path" id="6:81"/>
            <Fill name="Fill" id="6:82">
                <SolidColor colorValue="C80A0E20" name="Color" id="6:83"/>
            </Fill>
            <Stroke thickness="1.5" name="Edge" id="6:84">
                <SolidColor colorValue="66D8B070" name="Color" id="6:85"/>
            </Stroke>
        </Shape>
        <StateMachine name="Map" id="6:200">
            <StateMachineLayer name="Pulse" id="6:201">
                <AnyState x="200" y="-120" id="6:202"/>
                <ExitState x="400" y="-120" id="6:203"/>
                <EntryState id="6:204">
                    <StateTransition stateToId="6:205" id="6:206"/>
                </EntryState>
                <AnimationState x="200" animationId="6:210" id="6:205"/>
            </StateMachineLayer>
        </StateMachine>
        <!-- The peepal's ring pulses outward and fades, over and over. -->
        <LinearAnimation duration="90" loopValue="1" name="Pulse" id="6:210">
            <KeyedObject objectId="6:55" id="0:491861">
                <KeyedProperty propertyKey="16" id="0:491862">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear" id="0:491863"/>
                    <KeyFrameDouble value="2.2" frame="90" interpolationType="linear" id="0:491864"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17" id="0:491865">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear" id="0:491866"/>
                    <KeyFrameDouble value="2.2" frame="90" interpolationType="linear" id="0:491867"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="18" id="0:491868">
                    <KeyFrameDouble value="0.9" frame="0" interpolationType="linear" id="0:491869"/>
                    <KeyFrameDouble value="0" frame="90" interpolationType="linear" id="0:491870"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- World metres to the map's pixels, and degrees to radians. -->
    <DataConverterRangeMapper minInput="-21.0" maxInput="5.0000000000000036" minOutput="18.0" maxOutput="194.8" name="Map X" id="6:60"/>
    <DataConverterRangeMapper minInput="-8.0" maxInput="21.0" minOutput="18.0" maxOutput="215.2" name="Map Y" id="6:61"/>
    <DataConverterSystemDegsToRads name="Heading" id="6:62"/>

    <!-- Where he is (world metres), which way he faces (degrees on the map),
         and the two lines under it. -->
    <ViewModel name="Map" id="6:500">
        <ViewModelPropertyNumber componentProps="1" name="x" id="6:501"/>
        <ViewModelPropertyNumber componentProps="1" name="z" id="6:502"/>
        <ViewModelPropertyNumber componentProps="1" name="heading" id="6:503"/>
        <ViewModelPropertyString componentProps="1" name="label" id="6:504"/>
        <ViewModelPropertyString componentProps="1" name="status" id="6:505"/>
        <ViewModelInstance exports="true" name="Default" id="6:520">
            <ViewModelInstanceNumber propertyValue="-14.71" viewModelPropertyId="6:501" id="6:1501"/>
            <ViewModelInstanceNumber propertyValue="13.35" viewModelPropertyId="6:502" id="6:1502"/>
            <ViewModelInstanceNumber propertyValue="65" viewModelPropertyId="6:503" id="6:1503"/>
            <ViewModelInstanceString propertyValue="The peepal" viewModelPropertyId="6:504" id="6:1504"/>
            <ViewModelInstanceString propertyValue="Spirits felled  0" viewModelPropertyId="6:505" id="6:1505"/>
        </ViewModelInstance>
    </ViewModel>
    <ComponentAsset artboardId="6:1" name="Map" id="0:926"/>
</Rive>
